{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "opener:default",
    "sql:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "https:///**" },
        { "path": "http:///**" },
        { "path": "$HOME/**/*" },
        { "path": "$DOCUMENT/**/*" },
        { "path": "$DOWNLOAD/**/*" },
        { "path": "$DESKTOP/**/*" }
      ]
    }
  ]
}